# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true


[*.{sql,ddl,psql,ssql,duckdb}]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
max_line_length = 120

[*.py]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 120

[Makefile]
indent_style = tab
insert_final_newline = true
indent_size = 4

[pyproject.toml]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
